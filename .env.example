# Copy to .env and fill in. Never commit .env.

# CollegeFootballData API key (https://collegefootballdata.com/key)
CFBD_API=

# Postgres (only reachable inside the Docker network; port is never published)
POSTGRES_DB=cfb
POSTGRES_USER=cfb
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Address the web UI listens on: the VM's LAN IP. Never 0.0.0.0.
WEB_BIND=192.168.0.81
WEB_PORT=8000

# Display time zone (times are stored in UTC)
TZ=America/Denver

# Days of nightly database backups to keep in ./backups
BACKUP_KEEP_DAYS=14

# The Odds API key (https://the-odds-api.com, free Starter plan: 500 credits/month)
ODDS_API_KEY=

# API-Sports American Football key (free, 100 req/day; no college injuries, see CLAUDE.md)
APISPORTS_KEY=

# Cloudflare Tunnel token: Zero Trust > Networks > Tunnels > your tunnel > the long
# string after "--token" in the Docker install command. Treat it like a password.
CLOUDFLARE_TUNNEL_TOKEN=

# Token for Prometheus to scrape /metrics (LAN only; /metrics is off while this is empty). Any long random string:
#   openssl rand -hex 32 | sed 's/^/METRICS_TOKEN=/' >> .env
METRICS_TOKEN=
