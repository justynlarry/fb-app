# Copy to .env and fill in. Never commit .env.

# CollegeFootballData API key (https://collegefootballdata.com/key)
CFBD_API=

# Postgres (only reachable inside the Docker network; port is never published)
POSTGRES_DB=cfb
POSTGRES_USER=cfb
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Address the web UI listens on: the VM's LAN IP. Never 0.0.0.0.
WEB_BIND=192.168.0.81
WEB_PORT=8000

# Display time zone (times are stored in UTC)
TZ=America/Denver

# Days of nightly database backups to keep in ./backups
BACKUP_KEEP_DAYS=14

# The Odds API key (https://the-odds-api.com, free Starter plan: 500 credits/month)
ODDS_API_KEY=
